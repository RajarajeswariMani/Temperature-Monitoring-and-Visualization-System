graph TB

    TITLE["C SOFTWARE STATIC ARCHITECTURE<br/>Bare-Metal Implementation"]

    subgraph HAL["HARDWARE ABSTRACTION / MOCKS"]
        ADC["ADC<br/>adc.h / adc.c"]
        GPIO["GPIO<br/>gpio.h / gpio.c"]
        EEPROM["EEPROM<br/>eeprom.h / eeprom.c"]
    end

    subgraph APP["C APPLICATION SOFTWARE"]
        ISR["Timer ISR<br/>ISR_Timer100us_Handler()"]
        MON["Sample Management<br/>ISR latch + sample-ready flag"]
        MAIN["Application / Main Loop<br/>main.c"]
        SENSOR["Temperature Sensor<br/>TempSensor_ConvertRawToCelsius()"]
        CLASSIFY["Temperature Classification"]
        LED["LED Controller"]
    end

    ADC --> ISR
    ISR -->|"Latch raw value + set flag"| MON
    MON --> MAIN
    MAIN --> SENSOR
    SENSOR --> CLASSIFY
    CLASSIFY --> LED
    GPIO --> LED
    EEPROM --> MAIN

    TITLE --> APP