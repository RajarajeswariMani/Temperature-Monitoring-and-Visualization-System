graph TB

    TITLE["HARDWARE STATIC ARCHITECTURE<br/>Temperature Monitoring System"]

    subgraph HARDWARE["TARGET HARDWARE"]
        SENSOR["Temperature Sensor"]
        ADC["ADC Channel"]
        TIMER["Timer Peripheral"]
        MCU(("Microcontroller"))
        GREEN["Green LED"]
        YELLOW["Yellow LED"]
        RED["Red LED"]
        EEPROM[("EEPROM")]
    end

    SENSOR -->|"Analog signal"| ADC
    ADC -->|"Digital raw ADC value"| MCU
    TIMER -.->|"100 µs interrupt"| MCU
    MCU -->|"GPIO"| GREEN
    MCU -->|"GPIO"| YELLOW
    MCU -->|"GPIO"| RED
    MCU <-->|"I2C<br/>HW Revision + Serial Number"| EEPROM

    TITLE --> HARDWARE