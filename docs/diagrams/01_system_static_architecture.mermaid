    'altBackground': '#ffffff',
    'fontFamily': 'Helvetica'
  }
}}%%

graph TB

    TITLE["SYSTEM STATIC ARCHITECTURE<br/>Temperature Monitoring System"]


    subgraph HW["TARGET HARDWARE"]

        SENSOR["Temperature Sensor"]

        ADC["ADC Peripheral"]

        TIMER["100 µs Timer"]

        MCU(("Microcontroller"))

        GPIO["GPIO"]

        LEDS["Status LEDs<br/>Green / Yellow / Red"]

        EEPROM[("I2C EEPROM<br/>HW Revision + Serial Number")]

    end


    subgraph SW["EMBEDDED SOFTWARE"]

        ISR["100 µs Timer ISR"]

        MON["Temperature Monitoring"]

        SENSOR_DRV["Temperature Sensor"]

        STRATEGY["Sensor Resolution Strategy<br/>Rev-A / Rev-B"]

        CLASSIFY["Temperature Classifier"]

        LEDCTRL["LED Controller"]

        HAL["Hardware Abstraction"]

    end


    SENSOR -->|"Analog signal"| ADC

    ADC -->|"Raw ADC value"| MCU

    TIMER -.->|"100 µs interrupt"| MCU

    MCU --> GPIO

    GPIO --> LEDS

    MCU <-->|"I2C"| EEPROM


    TIMER -.->|"Triggers"| ISR

    ISR -->|"Latch raw value + set sample-ready"| MON


    MON -->|"Raw ADC"| SENSOR_DRV

    SENSOR_DRV -->|"Uses"| STRATEGY

    STRATEGY -->|"Temperature °C"| SENSOR_DRV

    SENSOR_DRV -->|"Temperature °C"| MON


    MON -->|"Temperature"| CLASSIFY

    CLASSIFY -->|"TempStatus"| MON


    MON -->|"Status"| LEDCTRL


    SENSOR_DRV -->|"ADC dependency"| HAL

    LEDCTRL -->|"GPIO dependency"| HAL

    MON -->|"ADC dependency"| HAL


    HAL -->|"ADC / GPIO / EEPROM hardware access"| MCU

    HAL -.->|"Configuration"| EEPROM


    TITLE --> HW

    TITLE --> SW